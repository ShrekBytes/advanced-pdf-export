{
  "name": "obsidian-advanced-pdf-export",
  "version": "4.7.7",
  "description": "Obsidian plugin for advanced PDF export",
  "author": "ShrekBytes",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShrekBytes/advanced-pdf-export"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "changelog": "node scripts/generate-changelog.mjs",
    "changelog:dry": "node scripts/generate-changelog.mjs --dry-run",
    "lint:commits": "node scripts/check-commits.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "obsidian": "^1.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "overrides": {
    "moment": "2.31.0"
  },
  "allowScripts": {
    "esbuild@0.25.5": true
  }
}
